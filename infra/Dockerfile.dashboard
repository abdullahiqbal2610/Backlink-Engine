FROM python:3.11-slim

WORKDIR /app

# Copy dashboard-specific requirements
COPY dashboard/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Also need psycopg2 for DB
RUN apt-get update && apt-get install -y libpq-dev build-essential && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir psycopg2 redis python-dotenv

# Copy the entire backend
COPY . .

# Ensure Python output is unbuffered
ENV PYTHONUNBUFFERED=1

WORKDIR /app/dashboard

# Expose port (Cloud Run uses PORT env variable, default 8080)
EXPOSE 8080

# Run Uvicorn - use $PORT env variable set by Cloud Run
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
