# ── Infrastructure ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=backlink_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Scraping & SEO ──────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here
TWOCAPTCHA_API_KEY=your_twocaptcha_key_here
# PROXY_URL=http://user:pass@proxy.example.com:PORT

# ── Platform Credentials ─────────────────────────────────────

# Reddit (Playwright — persistent browser session)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Hacker News (Playwright — form login, or manual on first run)
HN_USERNAME=your_hn_username
HN_PASSWORD=your_hn_password

# dev.to (Pure API — no browser needed)
# Get your key at: https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# GitHub Discussions (GraphQL API)
# Create a PAT at: https://github.com/settings/tokens (needs 'repo' scope)
GITHUB_TOKEN=your_github_pat_here

# Indie Hackers (Playwright — manual login on first run, then persistent)
IH_EMAIL=your_ih_email_here
IH_PASSWORD=your_ih_password_here

# ── Misc ─────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False


# ── Company Configuration ─────────────────────────────────────
COMPANY_NAME="AI Backlink Engine"
COMPANY_WEBSITE_URL="https://example.com"
COMPANY_DESCRIPTION="We build robust AI solutions and autonomous agents for enterprises."
COMPANY_TARGET_URLS="https://example.com/blogs,https://example.com/services"
COMPANY_TARGET_AUDIENCE="startup founders, CTOs, and engineering leaders"
